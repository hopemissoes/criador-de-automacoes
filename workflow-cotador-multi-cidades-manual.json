      "id": "cotacao_api",
      "name": "1-Cotação API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 300]
    },
    {
      "parameters": {
        "jsCode": "// Formata os resultados para envio no WhatsApp\nconst resultados = $input.first().json.resultados || {};\nconst totalCidades = $input.first().json.total_cidades || 0;\n\nlet mensagem = `*COTAÇÃO HAPVIDA*\\n`;\nmensagem += `Total de cidades: ${totalCidades}\\n`;\nmensagem += `${'='.repeat(30)}\\n\\n`;\n\nfor (const [cidade, dados] of Object.entries(resultados)) {\n  mensagem += `*📍 ${cidade}*\\n`;\n  \n  if (dados.success && dados.faixas && dados.faixas.length > 0) {\n    mensagem += `✅ Cotação obtida\\n\\n`;\n    dados.faixas.forEach(f => {\n      mensagem += `${f.faixa_etaria}: ${f.valor}\\n`;\n    });\n  } else {\n    mensagem += `❌ ${dados.error || 'Erro desconhecido'}\\n`;\n    if (dados.operadoras_disponiveis && dados.operadoras_disponiveis.length > 0) {\n      mensagem += `Operadoras disponíveis: ${dados.operadoras_disponiveis.join(', ')}\\n`;\n    }\n  }\n  \n  mensagem += `\\n${'─'.repeat(25)}\\n\\n`;\n}\n\n// Também retorna JSON estruturado\nreturn [{ \n  json: { \n    mensagem_formatada: mensagem,\n    resultados_json: resultados,\n    total_cidades: totalCidades\n  } \n}];"
      },
      "id": "formatar_msg",
      "name": "2-Formatar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
