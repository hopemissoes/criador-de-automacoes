        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"email\": \"jessicamendesbarbosa5@gmail.com\", \"senha\": \"amovoced28\", \"cidades\": $json.cidades } }}",
