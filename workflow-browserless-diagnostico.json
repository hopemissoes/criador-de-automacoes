{
  "name": "Browserless - Diagnóstico",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Executar Manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://evolution-docker.32vkgz.easypanel.host/",
        "options": {
          "timeout": 10000
        }
      },
      "id": "test-health",
      "name": "1. Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evolution-docker.32vkgz.easypanel.host/content",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"url\": \"https://example.com\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "test-content",
      "name": "2. Test /content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evolution-docker.32vkgz.easypanel.host/screenshot",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"url\": \"https://example.com\",\n  \"options\": {\n    \"type\": \"png\",\n    \"encoding\": \"base64\"\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "test-screenshot",
      "name": "3. Test /screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evolution-docker.32vkgz.easypanel.host/function",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"code\": \"module.exports = async ({ page }) => {\\n  await page.goto('https://example.com');\\n  const title = await page.title();\\n  return { success: true, title: title };\\n};\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "test-function",
      "name": "4. Test /function",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 650]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "resultado_health",
              "value": "={{ $('1. Health Check').item.json }}"
            },
            {
              "name": "resultado_content",
              "value": "={{ $('2. Test /content').item.json }}"
            },
            {
              "name": "resultado_screenshot",
              "value": "={{ $('3. Test /screenshot').item.json ? 'OK - Screenshot gerado' : 'ERRO' }}"
            },
            {
              "name": "resultado_function",
              "value": "={{ $('4. Test /function').item.json }}"
            }
          ]
        },
        "options": {}
      },
      "id": "merge-results",
      "name": "Consolidar Resultados",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 400]
    }
  ],
  "connections": {
    "Executar Manualmente": {
      "main": [
        [
          {
            "node": "1. Health Check",
            "type": "main",
            "index": 0
          },
          {
            "node": "2. Test /content",
            "type": "main",
            "index": 0
          },
          {
            "node": "3. Test /screenshot",
            "type": "main",
            "index": 0
          },
          {
            "node": "4. Test /function",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Health Check": {
      "main": [
        [
          {
            "node": "Consolidar Resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Test /content": {
      "main": [
        [
          {
            "node": "Consolidar Resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Test /screenshot": {
      "main": [
        [
          {
            "node": "Consolidar Resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Test /function": {
      "main": [
        [
          {
            "node": "Consolidar Resultados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "local"
  },
  "tags": []
}
