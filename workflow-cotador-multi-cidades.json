      "parameters": {
        "jsCode": "// Retorna resumo final após todas as cidades\nconst result = $input.first().json;\n\nlet mensagem = `\\n${'='.repeat(30)}\\n`;\nmensagem += `*RESUMO FINAL*\\n`;\nmensagem += `Total processado: ${result.total_cidades || 0} cidades\\n`;\nmensagem += `Sucesso: ${result.sucesso || 0}\\n`;\nmensagem += `Falhas: ${result.falhas || 0}\\n`;\nmensagem += `${'='.repeat(30)}`;\n\nreturn [{ \n  json: { \n    mensagem_resumo: mensagem,\n    resultado_completo: result\n  } \n}];"
      },
