{
  "name": "Cotador Hapvida - Multi Cidades",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Cotador Hapvida",
        "formDescription": "Digite as cidades para cotação (uma por linha)",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Cidades",
              "fieldType": "textarea",
              "placeholder": "Teresina - PI\nRecife - PE\nSalvador - BA",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "form_trigger",
      "name": "Formulário de Cidades",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [200, 300],
      "webhookId": "cotador-cidades"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution_puppeteer-cotador:80/cotacao",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"cidades\": $json.Cidades } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "cotacao_api",
      "name": "Executar Cotação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    }
  ],
  "connections": {
    "Formulário de Cidades": {
      "main": [[{"node": "Executar Cotação", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "multi-cidades-v3-direto",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "local"
  },
  "tags": []
}
