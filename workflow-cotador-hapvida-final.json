        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"code\": \"export default async function ({ page }) {\\n  const EMAIL = 'jessicamendesbarbosa5@gmail.com';\\n  const SENHA = 'amovoced28';\\n  const URL_LOGIN = 'https://app.cotadorsimplificado.com.br/login';\\n\\n  try {\\n    await page.goto(URL_LOGIN, { waitUntil: 'networkidle2', timeout: 60000 });\\n    await new Promise(r => setTimeout(r, 3000));\\n    \\n    // Aguardar campo de senha aparecer (confirma que a pagina carregou)\\n    await page.waitForSelector('#pwdInput', { timeout: 15000 });\\n    \\n    // Preencher email - pegar todos inputs e usar o primeiro\\n    const inputs = await page.$$('input');\\n    if (inputs.length >= 1) {\\n      await inputs[0].click();\\n      await inputs[0].type(EMAIL, { delay: 30 });\\n    }\\n    \\n    // Preencher senha usando o ID especifico\\n    const senhaInput = await page.$('#pwdInput');\\n    if (senhaInput) {\\n      await senhaInput.click();\\n      await senhaInput.type(SENHA, { delay: 30 });\\n    }\\n    \\n    await new Promise(r => setTimeout(r, 1000));\\n    \\n    // Clicar no botao de login\\n    const loginBtn = await page.$('button[type=\\\"submit\\\"]') || await page.$('button');\\n    if (loginBtn) {\\n      await loginBtn.click();\\n      await new Promise(r => setTimeout(r, 5000));\\n    }\\n    \\n    // Procurar botao Cotar Hapvida\\n    const elements = await page.$$('a, button, div, span');\\n    for (const el of elements) {\\n      const text = await page.evaluate(e => e.textContent, el);\\n      if (text && text.toLowerCase().includes('cotar hapvida')) {\\n        await el.click();\\n        await new Promise(r => setTimeout(r, 3000));\\n        return {\\n          success: true,\\n          message: 'Login realizado e clicou em Cotar Hapvida!',\\n          url: page.url()\\n        };\\n      }\\n    }\\n    \\n    return {\\n      success: true,\\n      message: 'Login realizado, mas botao Cotar Hapvida nao encontrado',\\n      url: page.url()\\n    };\\n  } catch (error) {\\n    return {\\n      success: false,\\n      error: error.message\\n    };\\n  }\\n}\"\n}",
