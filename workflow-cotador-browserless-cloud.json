    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.browserlessUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"code\": \"module.exports = async ({ page }) => {\\n  const EMAIL = '{{ $json.email }}';\\n  const SENHA = '{{ $json.senha }}';\\n  const URL_LOGIN = 'https://app.cotadorsimplificado.com.br/login';\\n\\n  try {\\n    await page.goto(URL_LOGIN, { waitUntil: 'networkidle2', timeout: 30000 });\\n    \\n    await page.waitForSelector('input[type=\\\"email\\\"]', { timeout: 10000 });\\n    await page.type('input[type=\\\"email\\\"]', EMAIL, { delay: 50 });\\n    await page.type('input[type=\\\"password\\\"]', SENHA, { delay: 50 });\\n    \\n    await Promise.all([\\n      page.waitForNavigation({ waitUntil: 'networkidle2', timeout: 30000 }),\\n      page.click('button[type=\\\"submit\\\"]')\\n    ]);\\n    \\n    await new Promise(r => setTimeout(r, 3000));\\n    \\n    const cotarButton = await page.$x(\\\"//a[contains(text(), 'Cotar Hapvida')] | //button[contains(text(), 'Cotar Hapvida')] | //*[contains(text(), 'Cotar Hapvida')]\\\");\\n    if (cotarButton.length > 0) {\\n      await cotarButton[0].click();\\n      await new Promise(r => setTimeout(r, 3000));\\n    }\\n    \\n    return {\\n      success: true,\\n      message: 'Automacao concluida! Clicou em Cotar Hapvida.',\\n      url: page.url()\\n    };\\n  } catch (error) {\\n    return {\\n      success: false,\\n      error: error.message\\n    };\\n  }\\n};\"\n}",
        "options": {
          "timeout": 120000
        }
      },
